# LLM API Key (required)
RS_API_KEY=your_api_key_here

# LLM Provider: deepseek or openai
RS_LLM_PROVIDER=deepseek

# LLM Model name
RS_LLM_MODEL=deepseek-chat

# API Base URL
RS_API_BASE_URL=https://api.deepseek.com

# Max tool calling rounds per query
RS_MAX_TOOL_ROUNDS=5

# SAM model type: vit_b / vit_l / vit_h
RS_SAM_MODEL=vit_b

# SAM weight cache directory
RS_SAM_CACHE_DIR=

# Output directory for analysis results
RS_OUTPUT_DIR=./output

# Server API key for web endpoint authentication (optional)
RS_SERVER_API_KEY=

# GEE project ID (from Google Cloud Console)
RS_GEE_PROJECT_ID=
